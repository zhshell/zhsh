{
  "request": {
    "system": "system",
    "messages": [{"role": "user", "content": "hello"}],
    "model": "model",
    "max_output_tokens": 32
  },
  "expected_request": {
    "relative_path": "/v1/responses",
    "json_body": {
      "input": [{"role": "user", "content": "hello"}],
      "instructions": "system",
      "max_output_tokens": 32,
      "model": "model",
      "reasoning": {"effort": "none"},
      "store": false,
      "text": {
        "format": {
          "type": "json_schema",
          "name": "zhsh_agent_response",
          "strict": true,
          "schema": {
            "type": "object",
            "properties": {
              "response": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "action": {"type": "string", "enum": ["run"]},
                      "purpose": {"type": "string"},
                      "command": {"type": "string"}
                    },
                    "required": ["action", "purpose", "command"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "action": {"type": "string", "enum": ["clarify"]},
                      "questions": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "id": {"type": "string"},
                            "prompt": {"type": "string"},
                            "multiple": {"type": "boolean"},
                            "choices": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "id": {"type": "string"},
                                  "label": {"type": "string"}
                                },
                                "required": ["id", "label"],
                                "additionalProperties": false
                              }
                            }
                          },
                          "required": ["id", "prompt", "multiple", "choices"],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": ["action", "questions"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "action": {"type": "string", "enum": ["done"]},
                      "answer": {"type": "string"}
                    },
                    "required": ["action", "answer"],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "required": ["response"],
            "additionalProperties": false
          }
        }
      }
    }
  },
  "success_response": {
    "status": 200,
    "headers": {},
    "body": {
      "status": "completed",
      "output": [
        {"type": "reasoning", "summary": []},
        {
          "type": "message",
          "role": "assistant",
          "content": [
            {"type": "output_text", "text": "{\"response\":{\"action\":\"done\",\"answer\":\"done\"}}"}
          ]
        }
      ],
      "usage": {"input_tokens": 10, "output_tokens": 8}
    }
  },
  "expected_success": {
    "text": "{\"response\":{\"action\":\"done\",\"answer\":\"done\"}}",
    "finish_reason": "completed"
  },
  "error_response": {
    "status": 429,
    "headers": {"retry-after": "2"},
    "body": {"error": {"message": "slow down", "type": "rate_limit_error"}}
  },
  "expected_error": {"kind": "rate_limited", "retry_after_ms": 2000}
}
